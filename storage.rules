rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userData() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function activeUser() { return signedIn() && userData().ativo == true; }
    function sameChurch(igrejaId) { return activeUser() && userData().igrejaId == igrejaId; }
    function roleIn(roles) { return activeUser() && userData().perfil in roles; }

    match /igrejas/{igrejaId}/solicitacoes/{ownerUid}/{fileName} {
      allow read: if sameChurch(igrejaId) &&
        (ownerUid == request.auth.uid || roleIn(['pastor', 'admin', 'tesoureiro']));

      allow create, update: if sameChurch(igrejaId) &&
        ownerUid == request.auth.uid &&
        roleIn(['pastor', 'admin', 'secretaria', 'tesoureiro', 'lider', 'midia']) &&
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));

      allow delete: if sameChurch(igrejaId) &&
        (ownerUid == request.auth.uid || roleIn(['pastor', 'admin']));
    }

    match /igrejas/{igrejaId}/branding/{fileName} {
      allow read: if sameChurch(igrejaId);
      allow create, update: if sameChurch(igrejaId) &&
        roleIn(['pastor', 'admin']) &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if sameChurch(igrejaId) && roleIn(['pastor', 'admin']);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
