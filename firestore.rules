rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function userData() { return userDoc().data; }
    function activeUser() { return signedIn() && userDoc().exists() && userData().ativo == true; }
    function sameChurch(igrejaId) { return activeUser() && userData().igrejaId == igrejaId; }
    function roleIn(roles) { return activeUser() && userData().perfil in roles; }
    function isAdminOrPastor() { return roleIn(['pastor', 'admin']); }
    function isTreasury() { return roleIn(['pastor', 'admin', 'tesoureiro']); }
    function leaderOwnCell(celulaId) { return roleIn(['lider']) && userData().celulaId == celulaId; }
    function internalRequester() { return roleIn(['pastor', 'admin', 'secretaria', 'tesoureiro', 'lider', 'midia']); }

    match /usuarios/{uid} {
      allow read: if activeUser() && (
        request.auth.uid == uid ||
        (isAdminOrPastor() && resource.data.igrejaId == userData().igrejaId)
      );
      allow create: if isAdminOrPastor() &&
        request.resource.data.igrejaId == userData().igrejaId;
      allow update: if isAdminOrPastor() &&
        resource.data.igrejaId == userData().igrejaId &&
        request.resource.data.igrejaId == resource.data.igrejaId;
      allow delete: if isAdminOrPastor() &&
        resource.data.igrejaId == userData().igrejaId;
    }

    match /igrejas/{igrejaId} {
      allow read: if sameChurch(igrejaId);
      allow write: if sameChurch(igrejaId) && isAdminOrPastor();
    }

    match /configuracoes/{igrejaId} {
      allow read: if sameChurch(igrejaId);
      allow create, update: if sameChurch(igrejaId) && isAdminOrPastor();
      allow delete: if false;
    }

    match /membros/{id} {
      allow read: if sameChurch(resource.data.igrejaId) &&
        (roleIn(['pastor', 'admin', 'secretaria']) || leaderOwnCell(resource.data.celulaId));
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
      allow update, delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
    }

    match /visitantes/{id} {
      allow read: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria', 'lider']);
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria', 'lider']);
      allow update: if sameChurch(resource.data.igrejaId) &&
        request.resource.data.igrejaId == resource.data.igrejaId &&
        roleIn(['pastor', 'admin', 'secretaria', 'lider']);
      allow delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria', 'lider']);
    }

    match /celulas/{id} {
      allow read: if sameChurch(resource.data.igrejaId) &&
        (roleIn(['pastor', 'admin', 'secretaria']) || (roleIn(['lider']) && userData().celulaId == id));
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
      allow update: if sameChurch(resource.data.igrejaId) &&
        request.resource.data.igrejaId == resource.data.igrejaId &&
        roleIn(['pastor', 'admin', 'secretaria']);
      allow delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
    }

    match /relatoriosCelula/{id} {
      allow read: if sameChurch(resource.data.igrejaId) &&
        (isAdminOrPastor() || leaderOwnCell(resource.data.celulaId));
      allow create: if sameChurch(request.resource.data.igrejaId) &&
        (isAdminOrPastor() || leaderOwnCell(request.resource.data.celulaId));
      allow update: if sameChurch(resource.data.igrejaId) &&
        (isAdminOrPastor() ||
          (leaderOwnCell(resource.data.celulaId) &&
           request.resource.data.celulaId == resource.data.celulaId &&
           request.resource.data.igrejaId == resource.data.igrejaId));
      allow delete: if sameChurch(resource.data.igrejaId) && isAdminOrPastor();
    }

    match /solicitacoesFinanceiras/{id} {
      allow read: if sameChurch(resource.data.igrejaId) &&
        (roleIn(['pastor', 'admin', 'tesoureiro']) || resource.data.solicitanteId == request.auth.uid);

      allow create: if sameChurch(request.resource.data.igrejaId) &&
        internalRequester() &&
        request.resource.data.solicitanteId == request.auth.uid &&
        request.resource.data.status == 'Pendente aprovação';

      allow update: if sameChurch(resource.data.igrejaId) && (
        (
          isAdminOrPastor() &&
          resource.data.status == 'Pendente aprovação' &&
          request.resource.data.status in ['Aprovada para financeiro', 'Reprovada'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'observacaoAprovacao', 'aprovadoPorId', 'aprovadoPorNome', 'aprovadoEm',
            'atualizadoPor', 'atualizadoEm'
          ])
        ) ||
        (
          isTreasury() &&
          resource.data.status == 'Aprovada para financeiro' &&
          request.resource.data.status == 'Lançada no financeiro' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'processadoFinanceiroPorId', 'processadoFinanceiroPorNome', 'processadoFinanceiroEm',
            'lancamentoFinanceiroId', 'atualizadoPor', 'atualizadoEm'
          ])
        )
      );

      allow delete: if false;
    }

    match /eventos/{id} {
      allow read: if sameChurch(resource.data.igrejaId);
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'midia', 'secretaria']);
      allow update, delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'midia', 'secretaria']);
    }

    match /avisos/{id} {
      allow read: if sameChurch(resource.data.igrejaId);
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'midia', 'secretaria']);
      allow update, delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'midia', 'secretaria']);
    }

    match /financeiro/{id} {
      allow read: if sameChurch(resource.data.igrejaId) && isTreasury();
      allow create: if sameChurch(request.resource.data.igrejaId) && isTreasury();
      allow update, delete: if sameChurch(resource.data.igrejaId) && isTreasury();
    }

    match /auditoria/{id} {
      allow read: if isAdminOrPastor() && resource.data.igrejaId == userData().igrejaId;
      allow create: if activeUser() &&
        request.resource.data.igrejaId == userData().igrejaId &&
        request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
