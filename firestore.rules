rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function userData() { return userDoc().data; }
    function activeUser() { return signedIn() && userDoc().exists() && userData().ativo == true; }
    function sameChurch(igrejaId) { return activeUser() && userData().igrejaId == igrejaId; }
    function roleIn(roles) { return activeUser() && userData().perfil in roles; }
    function isAdminOrPastor() { return roleIn(['pastor', 'admin']); }
    function isTreasury() { return roleIn(['pastor', 'admin', 'tesoureiro']); }

    match /usuarios/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isAdminOrPastor());
      allow create, update, delete: if isAdminOrPastor();
    }

    match /igrejas/{igrejaId} {
      allow read: if sameChurch(igrejaId);
      allow write: if sameChurch(igrejaId) && isAdminOrPastor();
    }

    match /membros/{id} {
      allow read: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
      allow update, delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
    }

    match /visitantes/{id} {
      allow read: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria', 'lider']);
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria', 'lider']);
      allow update, delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria', 'lider']);
    }

    match /celulas/{id} {
      allow read: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria', 'lider']);
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
      allow update, delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'secretaria']);
    }

    match /eventos/{id} {
      allow read: if sameChurch(resource.data.igrejaId);
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'midia', 'secretaria']);
      allow update, delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'midia', 'secretaria']);
    }

    match /avisos/{id} {
      allow read: if sameChurch(resource.data.igrejaId);
      allow create: if sameChurch(request.resource.data.igrejaId) && roleIn(['pastor', 'admin', 'midia', 'secretaria']);
      allow update, delete: if sameChurch(resource.data.igrejaId) && roleIn(['pastor', 'admin', 'midia', 'secretaria']);
    }

    match /financeiro/{id} {
      allow read: if sameChurch(resource.data.igrejaId) && isTreasury();
      allow create: if sameChurch(request.resource.data.igrejaId) && isTreasury();
      allow update, delete: if sameChurch(resource.data.igrejaId) && isTreasury();
    }

    match /auditoria/{id} {
      allow read: if isAdminOrPastor();
      allow create: if activeUser();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
